{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "council-manifest.schema.json",
  "title": "CouncilManifest",
  "description": "Active council composition and agent registry (.council/council-manifest.json).",
  "type": "object",
  "required": ["manifest_version", "created_at", "agents"],
  "properties": {
    "manifest_version": {
      "type": "string",
      "description": "Semantic version of this manifest format.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this manifest was created."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update."
    },
    "plugin_version": {
      "type": "string",
      "description": "Version of the henka-council plugin that created this manifest.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "agents": {
      "type": "array",
      "description": "Registered council agents and their current status.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agent_id", "agent_file", "autonomy_level", "status"],
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "Unique identifier for this agent."
          },
          "agent_file": {
            "type": "string",
            "description": "Path to the agent definition file."
          },
          "autonomy_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "description": "Nominal autonomy level for this agent."
          },
          "status": {
            "type": "string",
            "enum": ["active", "proposed", "disabled"],
            "description": "Current operational status."
          },
          "context": {
            "type": "string",
            "enum": ["inherit", "fork"],
            "description": "Context mode for this agent."
          },
          "tools": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Allowed tools for this agent."
          },
          "in_default_fanout": {
            "type": "boolean",
            "description": "Whether this agent participates in the default fan-out."
          }
        },
        "additionalProperties": false
      }
    },
    "active_sprint": {
      "type": ["integer", "null"],
      "description": "Currently active sprint number, or null if between sprints."
    },
    "council_state_path": {
      "type": "string",
      "description": "Path to the council state directory.",
      "default": ".council/"
    }
  },
  "additionalProperties": false
}
