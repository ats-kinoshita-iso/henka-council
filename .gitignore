# Subagent / orchestrator scratch files
# These get created in the working tree by Generator/Evaluator subagents
# during contract verification and self-review. They are not deliverables
# and should never be committed or trigger cross-sprint scope-drift gates.
tmp_*.py
tmp_*.md
check_*.py
gate*_test.py
sc*_check.py
sc_remaining.py

# Python build / cache
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Local-only env / secrets (defense-in-depth — none expected in this repo)
.env
.env.local

# Claude Code local artifacts (per-user, per-machine)
.claude/settings.local.json
.claude/worktrees/
.clone/

# Council runtime governance state (per-project; created by /council-kickoff).
# In a governed project this is runtime audit/state, not source; in this repo it
# is the dogfooded baseline created during development. The append scripts
# (scripts/append-henka.py, scripts/append-decision.py) git-add canonical
# .council/ paths — ignoring the directory keeps those runtime writes from being
# staged into the plugin's own source tree.
.council/
